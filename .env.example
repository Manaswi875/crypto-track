# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://user:password@localhost:5432/cryptopulse?schema=public"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Anthropic: powers the AI insights, follow-ups, setup and market summary (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# Public app URL used in Slack and email alerts
APP_URL="http://localhost:3000"

# Slack incoming webhook (optional)
SLACK_WEBHOOK_URL=""

# Email through Resend (optional; all three values are required)
RESEND_API_KEY=""
ALERT_EMAIL_FROM="Crypto Pulse <alerts@example.com>"
ALERT_EMAIL_TO=""
