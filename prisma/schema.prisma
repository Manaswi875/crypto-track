// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  alerts    Alert[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coin {
  id                String             @id
  symbol            String             @unique
  name              String
  lastPrice         Float?
  status            String             @default("active")
  priceHistory      PriceHistory[]
  volatilityEvents  VolatilityEvent[]
  whaleTransactions WhaleTransaction[]
  alerts            Alert[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  coinId    String
  coin      Coin     @relation(fields: [coinId], references: [id])
  type      String // price_above, price_below, pct_change
  threshold Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VolatilityEvent {
  id            String    @id @default(cuid())
  coinId        String
  coin          Coin      @relation(fields: [coinId], references: [id])
  changePct     Float
  severity      String // low, medium, high
  aiExplanation String?   @db.Text
  source        String    @default("live") // live, replay
  startPrice    Float?
  endPrice      Float?
  windowLabel   String? // e.g. "24h", "10m"
  context       Json? // price context captured when the event was created
  moves         Json? // every tracked coin's % move that day, e.g. {"bitcoin": -14.07, "ethereum": -14.91}
  occurredAt    DateTime  @default(now())
  briefs        Brief[]
  createdAt     DateTime  @default(now())
  Insight       Insight[]
}

model WhaleTransaction {
  id          String   @id @default(cuid())
  coinId      String
  coin        Coin     @relation(fields: [coinId], references: [id])
  amountUsd   Float
  type        String // inflow, outflow, unknown
  hash        String   @unique
  fromAddress String?
  toAddress   String?
  createdAt   DateTime @default(now())
}

model PriceHistory {
  id        String   @id @default(cuid())
  coinId    String
  coin      Coin     @relation(fields: [coinId], references: [id])
  price     Float
  volume    Float?
  timestamp DateTime @default(now())

  @@index([coinId, timestamp])
}

// --- Personal investors: the core product ---

model Investor {
  id             String     @id
  name           String
  tagline        String // e.g. "Saving for a house"
  age            Int?
  goal           String // short, e.g. "Buy our first home"
  cryptoReason   String     @default("") // why they own crypto, e.g. "A small long-term bet"
  timeHorizon    String // when they need the money, e.g. "Spring 2027"
  dropComfortPct Float // how far crypto could fall before they'd lose sleep
  isDemo         Boolean    @default(true)
  positions      Position[]
  insights       Insight[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Position {
  id          String   @id @default(cuid())
  investorId  String
  investor    Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  symbol      String // fund ticker for crypto funds (IBIT), coin symbol when held directly, or CASH / INVEST
  name        String // plain-English label shown to the user
  assetClass  String // crypto_etf, crypto, cash, investments
  coinId      String? // underlying crypto exposure
  marketValue Float
  investedUsd Float? // what they put in, for gain/loss if they sold today

  @@index([investorId])
}

model Insight {
  id               String           @id @default(cuid())
  eventId          String
  event            VolatilityEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  investorId       String
  investor         Investor         @relation(fields: [investorId], references: [id], onDelete: Cascade)
  status           String           @default("generating") // generating, ready, failed
  // Deterministic numbers, computed in code
  exposureUsd      Float
  impactUsd        Float
  impactPctOfTotal Float
  // Agent output
  urgency          String? // check_in_today, good_to_know, within_your_plan
  headline         String?
  whatHappened     String?          @db.Text
  whatItMeans      String?          @db.Text
  yourGoal         String?          @db.Text
  questions        Json?
  citedFacts       Json?
  complianceFlags  Json?
  trace            Json?
  // Run metrics
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  costUsd          Float?
  latencyMs        Int?
  error            String?          @db.Text
  messages         InsightMessage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([eventId, investorId])
}

// Follow-up questions about an insight, and the answers
model InsightMessage {
  id              String   @id @default(cuid())
  insightId       String
  insight         Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  role            String // user, assistant
  content         String   @db.Text
  quote           String?  @db.Text // the highlighted text the question is about
  complianceFlags Json?
  costUsd         Float?
  createdAt       DateTime @default(now())

  @@index([insightId, createdAt])
}

// --- Advisor book monitoring (the same engine, scaled to an advisor's clients) ---

model Advisor {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  households Household[]
  createdAt  DateTime    @default(now())
}

model Household {
  id             String    @id @default(cuid())
  advisorId      String
  advisor        Advisor   @relation(fields: [advisorId], references: [id])
  name           String // "Patel Household"
  primaryContact String // "Priya Patel"
  riskProfile    String // conservative, moderate, aggressive
  lifeStage      String
  clientSince    DateTime
  lastContactAt  DateTime
  notes          String    @db.Text // recent meeting notes
  holdings       Holding[]
  briefs         Brief[]
  createdAt      DateTime  @default(now())
}

model Holding {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  symbol      String // IBIT, AAPL, BND ...
  name        String
  assetClass  String // equity, fixed_income, cash, crypto_etf, crypto
  coinId      String? // underlying crypto exposure, e.g. bitcoin for IBIT
  marketValue Float

  @@index([householdId])
  @@index([coinId])
}

model Brief {
  id                 String          @id @default(cuid())
  eventId            String
  event              VolatilityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  householdId        String
  household          Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  status             String          @default("queued") // queued, generating, draft, approved, rejected, failed
  // Deterministic impact numbers, computed in code (not by the model)
  exposureUsd        Float
  impactUsd          Float
  impactPctOfAum     Float
  // Agent output
  priority           String? // call_today, send_message, monitor
  advisorSummary     String?         @db.Text
  clientMessage      String?         @db.Text
  rationale          String?         @db.Text
  citedFacts         Json?
  complianceFlags    Json?
  trace              Json?
  // Advisor review
  finalClientMessage String?         @db.Text
  edited             Boolean         @default(false)
  reviewedBy         String?
  reviewedAt         DateTime?
  // Run metrics
  model              String?
  inputTokens        Int?
  outputTokens       Int?
  costUsd            Float?
  latencyMs          Int?
  error              String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([eventId, householdId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // event_created, briefs_requested, brief_generated, brief_failed, brief_approved, brief_rejected
  actor      String // system, agent, advisor:<email>
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
}
