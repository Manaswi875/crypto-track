// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Coin {
  id                String             @id
  symbol            String             @unique
  name              String
  lastPrice         Float?
  status            String             @default("active")
  priceHistory      PriceHistory[]
  volatilityEvents  VolatilityEvent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model VolatilityEvent {
  id            String    @id @default(cuid())
  coinId        String
  coin          Coin      @relation(fields: [coinId], references: [id])
  changePct     Float
  severity      String // low, medium, high
  aiExplanation String?   @db.Text
  source        String    @default("live") // live, replay
  startPrice    Float?
  endPrice      Float?
  windowLabel   String? // e.g. "24h", "10m"
  context       Json? // price context captured when the event was created
  moves         Json? // every tracked coin's % move that day, e.g. {"bitcoin": -14.07, "ethereum": -14.91}
  occurredAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  Insight       Insight[]
}

model PriceHistory {
  id        String   @id @default(cuid())
  coinId    String
  coin      Coin     @relation(fields: [coinId], references: [id])
  price     Float
  volume    Float?
  timestamp DateTime @default(now())

  @@index([coinId, timestamp])
}

// --- Personal investors: the core product ---

model Investor {
  id             String     @id
  name           String
  tagline        String // e.g. "Saving for a house"
  age            Int?
  goal           String // short, e.g. "Buy our first home"
  cryptoReason   String     @default("") // why they own crypto, e.g. "A small long-term bet"
  timeHorizon    String // when they need the money, e.g. "Spring 2027"
  dropComfortPct Float // how far crypto could fall before they'd lose sleep
  isDemo         Boolean    @default(true)
  positions      Position[]
  insights       Insight[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Position {
  id          String   @id @default(cuid())
  investorId  String
  investor    Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  symbol      String // fund ticker for crypto funds (IBIT), coin symbol when held directly, or CASH / INVEST
  name        String // plain-English label shown to the user
  assetClass  String // crypto_etf, crypto, cash, investments
  coinId      String? // underlying crypto exposure
  marketValue Float
  investedUsd Float? // what they put in, for gain/loss if they sold today
  units       Float? // coin units the holding represents, so its value follows the live price

  @@index([investorId])
}

model Insight {
  id               String           @id @default(cuid())
  eventId          String
  event            VolatilityEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  investorId       String
  investor         Investor         @relation(fields: [investorId], references: [id], onDelete: Cascade)
  status           String           @default("generating") // generating, ready, failed
  // Deterministic numbers, computed in code
  exposureUsd      Float
  impactUsd        Float
  impactPctOfTotal Float
  // Agent output
  urgency          String? // check_in_today, good_to_know, within_your_plan
  headline         String?
  whatHappened     String?          @db.Text
  whatItMeans      String?          @db.Text
  yourGoal         String?          @db.Text
  questions        Json?
  citedFacts       Json?
  complianceFlags  Json?
  trace            Json?
  // Run metrics
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  costUsd          Float?
  latencyMs        Int?
  error            String?          @db.Text
  messages         InsightMessage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([eventId, investorId])
}

// Follow-up questions about an insight, and the answers
model InsightMessage {
  id              String   @id @default(cuid())
  insightId       String
  insight         Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  role            String // user, assistant
  content         String   @db.Text
  quote           String?  @db.Text // the highlighted text the question is about
  complianceFlags Json?
  costUsd         Float?
  createdAt       DateTime @default(now())

  @@index([insightId, createdAt])
}

